rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catch-all safety gate (Master deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global primitive functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation helper to prevent update gaps / shadow attributes
    function isValidUserProfile(data) {
      return data.get('name', '') is string 
        && data.get('name', '').size() <= 100
        && data.get('email', '') is string 
        && data.get('email', '').size() <= 150
        && data.get('onboarded', false) is bool
        && (data.get('exam', null) == null || (data.get('exam', null) is string && data.get('exam', '').size() <= 100))
        && (data.get('language', null) == null || (data.get('language', null) is string && data.get('language', '').size() <= 50))
        && (data.get('customExamDetails', null) == null || (data.get('customExamDetails', null) is string && data.get('customExamDetails', '').size() <= 1000));
    }

    // Test result verification helper
    function isValidTestResult(data) {
      return data.get('date', '') is string
        && data.get('score', 0) is number
        && data.get('total', 0) is number
        && data.get('timeSpent', 0) is number
        && data.get('subject', '') is string;
    }

    // Users collection match block
    match /users/{userId} {
      allow get, create, update: if isOwner(userId);
      allow delete: if false; // Users cannot be deleted from Client SDK

      // Subcollection for isolated test results
      match /tests/{testId} {
        allow get, list, create: if isOwner(userId);
        allow update, delete: if false; // Test history is immutable once taken to prevent cheating or data loss
      }
    }
  }
}
